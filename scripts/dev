#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

REGION="${AWS_REGION:-ca-central-1}"

APP_STACK="commandlog-dev-app"
DATA_STACK="commandlog-dev-data"
AUTH_STACK="commandlog-dev-auth"
FRONTEND_STACK="commandlog-dev-frontend"


stack_output() {
    local stack="$1"
    local key="$2"

    aws cloudformation describe-stacks \
        --stack-name "$stack" \
        --region "$REGION" \
        --query "Stacks[0].Outputs[?OutputKey=='${key}'].OutputValue" \
        --output text
}


validate() {
    echo "Validating application template..."
    sam validate \
        --lint \
        --template-file infrastructure/template.yaml

    echo "Validating data template..."
    aws cloudformation validate-template \
        --template-body file://infrastructure/data.yaml \
        --region "$REGION" \
        >/dev/null

    echo "Validating frontend template..."
    aws cloudformation validate-template \
        --template-body file://infrastructure/frontend.yaml \
        --region "$REGION" \
        >/dev/null

    echo "Validation passed."
}


build() {
    echo "Building application..."
    rm -rf .aws-sam

    sam build \
        --template-file infrastructure/template.yaml
}


deploy_app() {
    validate
    build

    local account_id
    account_id=$(aws sts get-caller-identity \
        --query Account \
        --output text)

    local app_role_arn
    app_role_arn="arn:aws:iam::${account_id}:role/commandlog-dev-app-cloudformation-role"

    local deck_state
    local play_events
    local user_profile
    local change_log
    local deck_diff
    local cards_dim
    local snapshot_bucket
    local raw_bucket
    local generated_bucket
    local issuer
    local client_id
    local frontend_origin

    deck_state=$(stack_output "$DATA_STACK" DeckStateTableName)
    play_events=$(stack_output "$DATA_STACK" PlayEventsTableName)
    user_profile=$(stack_output "$DATA_STACK" UserProfileTableName)
    change_log=$(stack_output "$DATA_STACK" DeckChangeLogTableName)
    deck_diff=$(stack_output "$DATA_STACK" DeckDiffTableName)
    cards_dim=$(stack_output "$DATA_STACK" CardsDimTableName)
    snapshot_bucket=$(stack_output "$DATA_STACK" SnapshotBucketName)
    raw_bucket=$(stack_output "$DATA_STACK" RawBucketName)
    generated_bucket=$(stack_output "$DATA_STACK" GeneratedBucketName)

    issuer=$(stack_output "$AUTH_STACK" Issuer)
    client_id=$(stack_output "$AUTH_STACK" UserPoolClientId)

    frontend_origin="https://$(stack_output "$FRONTEND_STACK" DistributionDomainName)"

    sam deploy \
        --no-fail-on-empty-changeset \
        --template-file "$(pwd)/.aws-sam/build/template.yaml" \
        --stack-name "$APP_STACK" \
        --region "$REGION" \
        --capabilities CAPABILITY_IAM \
        --role-arn "$app_role_arn" \
        --resolve-s3 \
        --parameter-overrides \
            AppEnvironment=dev \
            DeckStateTableName="$deck_state" \
            PlayEventsTableName="$play_events" \
            UserProfileTableName="$user_profile" \
            DeckChangeLogTableName="$change_log" \
            DeckDiffTableName="$deck_diff" \
            CardsDimTableName="$cards_dim" \
            SnapshotBucketName="$snapshot_bucket" \
            RawBucketName="$raw_bucket" \
            GeneratedBucketName="$generated_bucket" \
            CognitoIssuer="$issuer" \
            CognitoAudience="$client_id" \
            FrontendOrigin="$frontend_origin"
}


deploy_data() {
    local account_id
    account_id=$(aws sts get-caller-identity \
        --query Account \
        --output text)

    local data_role_arn
    data_role_arn="arn:aws:iam::${account_id}:role/commandlog-dev-data-cloudformation-role"

    aws cloudformation deploy \
        --template-file infrastructure/data.yaml \
        --stack-name "$DATA_STACK" \
        --parameter-overrides EnvironmentName=dev \
        --role-arn "$data_role_arn" \
        --region "$REGION"
}


routes() {
    local api_id
    api_id=$(stack_output "$APP_STACK" HttpApiId)

    aws apigatewayv2 get-routes \
        --api-id "$api_id" \
        --region "$REGION" \
        --query 'Items[].{
            RouteKey:RouteKey,
            AuthorizationType:AuthorizationType
        }' \
        --output table
}


routes_test() {
    local api_id
    api_id=$(stack_output "$APP_STACK" HttpApiId)

    local actual
    local expected

    actual=$(
        aws apigatewayv2 get-routes \
            --api-id "$api_id" \
            --region "$REGION" \
            --query 'Items[].[RouteKey,AuthorizationType]' \
            --output text \
        | awk '{
            auth=$NF
            $NF=""
            sub(/[[:space:]]+$/, "")
            print $0 "|" auth
        }' \
        | sort
    )

    expected=$(
        cat <<'EOF' | sort
GET /decks|JWT
GET /decks/{deck_id}|JWT
GET /decks/{deck_id}/diff|JWT
GET /games|JWT
GET /me/profile|JWT
GET /pick|JWT
GET /stats/summary|JWT
GET /stats/version|JWT
POST /play|JWT
PUT /me/profile|JWT
EOF
    )

    echo "=== HTTP API route tests ==="
    echo

    if [[ "$actual" == "$expected" ]]; then
        printf "PASS  expected route set and JWT authorization\n"
    else
        echo "FAIL  API route configuration differs from expected."
        echo

        diff -u \
            <(printf '%s\n' "$expected") \
            <(printf '%s\n' "$actual") \
            || true

        return 1
    fi

    echo
    echo "HTTP API route tests passed."
}


status() {
    aws cloudformation describe-stacks \
        --stack-name "$DATA_STACK" \
        --region "$REGION" \
        --query 'Stacks[0].[StackName,StackStatus]' \
        --output text

    aws cloudformation describe-stacks \
        --stack-name "$AUTH_STACK" \
        --region "$REGION" \
        --query 'Stacks[0].[StackName,StackStatus]' \
        --output text

    aws cloudformation describe-stacks \
        --stack-name "$APP_STACK" \
        --region "$REGION" \
        --query 'Stacks[0].[StackName,StackStatus]' \
        --output text

    aws cloudformation describe-stacks \
        --stack-name "$FRONTEND_STACK" \
        --region "$REGION" \
        --query 'Stacks[0].[StackName,StackStatus]' \
        --output text
}


events() {
    local raw_bucket
    raw_bucket=$(stack_output "$DATA_STACK" RawBucketName)

    echo "=== Raw bucket EventBridge configuration ==="
    aws s3api get-bucket-notification-configuration \
        --bucket "$raw_bucket" \
        --region "$REGION"

    echo
    echo "=== CommandLog schedules ==="
    aws scheduler list-schedules \
        --name-prefix commandlog-dev- \
        --region "$REGION" \
        --query 'Schedules[].{
            Name:Name,
            State:State,
            Target:Target.Arn
        }' \
        --output table

    echo
    echo "=== Scryfall latest-object rule ==="
    aws events describe-rule \
        --name commandlog-dev-scryfall-latest-created \
        --region "$REGION"

    echo
    echo "=== Rule targets ==="
    aws events list-targets-by-rule \
        --rule commandlog-dev-scryfall-latest-created \
        --region "$REGION" \
        --output table
}


events_test() (
    local raw_bucket
    raw_bucket=$(stack_output "$DATA_STACK" RawBucketName)

    local rule_name="commandlog-dev-scryfall-latest-created"
    local pattern_file
    pattern_file=$(mktemp)

    trap 'rm -f "$pattern_file"' EXIT

    aws events describe-rule \
        --name "$rule_name" \
        --region "$REGION" \
        --query 'EventPattern' \
        --output text > "$pattern_file"

    test_event() {
        local name="$1"
        local bucket="$2"
        local key="$3"
        local expected="$4"

        local event
        event=$(cat <<EOF
{
  "version": "0",
  "id": "commandlog-test",
  "detail-type": "Object Created",
  "source": "aws.s3",
  "account": "000000000000",
  "time": "2026-09-01T00:00:00Z",
  "region": "$REGION",
  "resources": [],
  "detail": {
    "bucket": {
      "name": "$bucket"
    },
    "object": {
      "key": "$key"
    }
  }
}
EOF
)

        local result
        result=$(aws events test-event-pattern \
            --event-pattern "file://$pattern_file" \
            --event "$event" \
            --region "$REGION" \
            --query Result \
            --output text)

        if [[ "$result" == "$expected" ]]; then
            printf "PASS  %-28s expected=%s actual=%s\n" \
                "$name" "$expected" "$result"
        else
            printf "FAIL  %-28s expected=%s actual=%s\n" \
                "$name" "$expected" "$result"
            return 1
        fi
    }

    echo "=== Background event tests ==="
    echo

    test_event \
        "latest Oracle Cards" \
        "$raw_bucket" \
        "scryfall/oracle_cards/latest.jsonl.gz" \
        "True"

    test_event \
        "historical Oracle Cards" \
        "$raw_bucket" \
        "scryfall/oracle_cards/dt=20260901/oracle_cards_20260901T000000Z.jsonl.gz" \
        "False"

    test_event \
        "wrong bucket" \
        "commandlog-wrong-bucket" \
        "scryfall/oracle_cards/latest.jsonl.gz" \
        "False"

    echo
    echo "Background event tests passed."
)


deploy_frontend() {
    local account_id
    account_id=$(aws sts get-caller-identity \
        --query Account \
        --output text)

    local frontend_role_arn
    frontend_role_arn="arn:aws:iam::${account_id}:role/commandlog-dev-frontend-cloudformation-role"

    local generated_bucket
    generated_bucket=$(stack_output "$DATA_STACK" GeneratedBucketName)

    echo "Deploying frontend infrastructure..."

    aws cloudformation deploy \
        --template-file infrastructure/frontend.yaml \
        --stack-name "$FRONTEND_STACK" \
        --parameter-overrides \
            EnvironmentName=dev \
            GeneratedBucketName="$generated_bucket" \
        --role-arn "$frontend_role_arn" \
        --region "$REGION"
}


frontend_test() (
    local web_bucket
    local generated_bucket
    local cf_domain

    web_bucket=$(stack_output "$FRONTEND_STACK" WebBucketName)
    generated_bucket=$(stack_output "$DATA_STACK" GeneratedBucketName)
    cf_domain=$(stack_output "$FRONTEND_STACK" DistributionDomainName)

    local tmp_index
    local tmp_data

    tmp_index=$(mktemp)
    tmp_data=$(mktemp)

    trap 'rm -f "$tmp_index" "$tmp_data"' EXIT

    echo '<h1>CommandLog dev frontend</h1>' > "$tmp_index"
    echo '{"source":"generated-bucket","ok":true}' > "$tmp_data"

    aws s3 cp \
        "$tmp_data" \
        "s3://${generated_bucket}/data/cloudfront-test.json" \
        --content-type "application/json" \
        --region "$REGION" \
        >/dev/null

    aws s3 cp \
        "$tmp_index" \
        "s3://${web_bucket}/index.html" \
        --content-type "text/html" \
        --region "$REGION" \
        >/dev/null

    check_status() {
        local name="$1"
        local url="$2"
        local expected="$3"

        local actual
        actual=$(curl -s -o /dev/null -w "%{http_code}" "$url")

        if [[ "$actual" == "$expected" ]]; then
            printf "PASS  %-28s expected=%s actual=%s\n" \
                "$name" "$expected" "$actual"
        else
            printf "FAIL  %-28s expected=%s actual=%s\n" \
                "$name" "$expected" "$actual"
            return 1
        fi
    }

    echo "=== Frontend tests ==="
    echo

    check_status \
        "web bucket direct" \
        "https://${web_bucket}.s3.${REGION}.amazonaws.com/index.html" \
        "403"

    check_status \
        "CloudFront frontend" \
        "https://${cf_domain}/" \
        "200"

    check_status \
        "CloudFront generated data" \
        "https://${cf_domain}/data/cloudfront-test.json" \
        "200"

    check_status \
        "generated bucket direct" \
        "https://${generated_bucket}.s3.${REGION}.amazonaws.com/data/cloudfront-test.json" \
        "403"

    echo
    echo "Frontend tests passed."
)


cors_test() {
    local cf_domain
    local api_url

    cf_domain=$(stack_output "$FRONTEND_STACK" DistributionDomainName)
    api_url=$(stack_output "$APP_STACK" HttpApiUrl)

    echo "=== CORS tests ==="
    echo

    local allowed_headers
    allowed_headers=$(curl -si \
        -X OPTIONS \
        -H "Origin: https://${cf_domain}" \
        -H "Access-Control-Request-Method: GET" \
        -H "Access-Control-Request-Headers: authorization" \
        "${api_url%/}/decks")

    if echo "$allowed_headers" | grep -qi \
        "access-control-allow-origin: https://${cf_domain}"; then
        echo "PASS  CloudFront origin allowed"
    else
        echo "FAIL  CloudFront origin not allowed"
        return 1
    fi

    local rejected_headers
    rejected_headers=$(curl -si \
        -X OPTIONS \
        -H "Origin: https://evil.example.com" \
        -H "Access-Control-Request-Method: GET" \
        "${api_url%/}/decks")

    if echo "$rejected_headers" | grep -qi \
        "access-control-allow-origin: https://evil.example.com"; then
        echo "FAIL  unexpected origin allowed"
        return 1
    else
        echo "PASS  unexpected origin rejected"
    fi

    echo
    echo "CORS tests passed."
}


test_unit() {
    echo "Running unit tests..."
    python -m pytest
}


stack_test() {
    local failed=0

    check_stack() {
        local stack="$1"

        local actual
        actual=$(aws cloudformation describe-stacks \
            --stack-name "$stack" \
            --region "$REGION" \
            --query 'Stacks[0].StackStatus' \
            --output text)

        case "$actual" in
            CREATE_COMPLETE|UPDATE_COMPLETE)
                printf "PASS  %-32s %s\n" "$stack" "$actual"
                ;;
            *)
                printf "FAIL  %-32s %s\n" "$stack" "$actual"
                failed=1
                ;;
        esac
    }

    echo "=== CloudFormation stack tests ==="
    echo

    check_stack "$DATA_STACK"
    check_stack "$AUTH_STACK"
    check_stack "$APP_STACK"
    check_stack "$FRONTEND_STACK"

    if (( failed !=0 )); then
        return 1
    fi

    echo
    echo "CloudFormation stack tests passed."
}


api_test() {
    local api_url
    api_url=$(stack_output "$APP_STACK" HttpApiUrl)

    local client_id
    client_id=$(stack_output "$AUTH_STACK" UserPoolClientId)

    local username
    username="${COMMANDLOG_DEV_USERNAME:-commandlog-dev@example.com}"

    echo "=== HTTP API authentication tests ==="
    echo

    local unauthenticated_status
    unauthenticated_status=$(curl -s \
        -o /dev/null \
        -w "%{http_code}" \
        "${api_url%/}/decks")

    if [[ "$unauthenticated_status" == "401" ]]; then
        printf "PASS  %-28s expected=401 actual=%s\n" \
            "unauthenticated /decks" \
            "$unauthenticated_status"
    else
        printf "FAIL  %-28s expected=401 actual=%s\n" \
            "unauthenticated /decks" \
            "$unauthenticated_status"
        return 1
    fi

    local id_token="${COMMANDLOG_DEV_ID_TOKEN:-}"

    if [[ -z "$id_token" ]]; then
        if [[ -z "${COMMANDLOG_DEV_PASSWORD:-}" ]]; then
            echo
            echo "FAIL  authenticated API test requires one of:"
            echo "      COMMANDLOG_DEV_ID_TOKEN"
            echo "      COMMANDLOG_DEV_PASSWORD"
            return 1
        fi

        id_token=$(aws cognito-idp initiate-auth \
            --region "$REGION" \
            --client-id "$client_id" \
            --auth-flow USER_PASSWORD_AUTH \
            --auth-parameters \
                USERNAME="$username",PASSWORD="$COMMANDLOG_DEV_PASSWORD" \
            --query 'AuthenticationResult.IdToken' \
            --output text)
    fi

    local authenticated_status
    authenticated_status=$(curl -s \
        -o /dev/null \
        -w "%{http_code}" \
        -H "Authorization: Bearer ${id_token}" \
        "${api_url%/}/decks")

    if [[ "$authenticated_status" == "200" ]]; then
        printf "PASS  %-28s expected=200 actual=%s\n" \
            "authenticated /decks" \
            "$authenticated_status"
    else
        printf "FAIL  %-28s expected=200 actual=%s\n" \
            "authenticated /decks" \
            "$authenticated_status"
        return 1
    fi

    echo
    echo "HTTP API authentication tests passed."
}


